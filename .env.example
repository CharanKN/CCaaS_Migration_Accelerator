# Create an API key in OpenRouter, then copy this file to .env.
# Never commit the real .env file.

# ── Backend server (all optional; sensible defaults shown) ─────────────────
# Host/port uvicorn binds to.
HOST=127.0.0.1
PORT=8000
# Log verbosity: debug | info | warning | error
LOG_LEVEL=info
# Browser origins allowed to call the API cross-origin. Default "*" is fine when
# the backend also serves the frontend (same origin). Set a comma-separated
# allow-list to enable credentialed cross-origin requests; a wildcard keeps
# credentials OFF so the API never reflects an arbitrary origin.
# Example: CORS_ORIGINS=https://suite.internal.example.com,https://admin.example.com
CORS_ORIGINS=*

# ── OpenRouter (LLM) ───────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# Use a model slug from https://openrouter.ai/models.
# Choose a model that supports tool calling or structured output.
OPENROUTER_MODEL=

# Optional override for an OpenRouter-compatible gateway.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional completion budget for unstructured-workbook fallback calls.
OPENROUTER_MAX_TOKENS=8192

# GitHub deployment config for the "Deploy Terraform to GitHub" button.
# The token is read from here and is never shown or entered in the UI, so it
# stays server-side. Without GITHUB_TOKEN the deploy button is disabled.
# Use a fine-grained personal access token with Contents: write on the target repo.
GITHUB_TOKEN=
# Default target repository in owner/name form, e.g. my-org/connect-infra.
# Prefills the (still editable) repository field in the panel.
GITHUB_REPOSITORY=
# Default branch to commit to (created from the default branch if it does not exist).
GITHUB_BRANCH=main
# Default repository-relative folder for the generated files.
GITHUB_TARGET_DIRECTORY=terraform
# Optional API base URL for GitHub Enterprise Server, e.g. https://ghe.example.com/api/v3
GITHUB_API_URL=
